# Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Browser build values are required by the Azure GitHub Actions build.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Lipila collections. Start with a sandbox key and use LIPILA_ENV=production
# only after the merchant account, callback URL, and live key are configured.
LIPILA_API_KEY=your-lipila-api-key
LIPILA_WEBHOOK_SECRET=your-lipila-webhook-signing-secret
LIPILA_ENV=sandbox
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DAILY_SALES_CRON_SECRET=generate-a-long-random-secret

# Gmail SMTP is the simplest option for a demo that must deliver to real inboxes.
# Turn on Google 2-Step Verification and generate an App Password; don't use
# your normal Google account password here.
EMAIL_PROVIDER=gmail
GMAIL_USER=your-demo-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional Resend alternative. Set EMAIL_PROVIDER=resend to select it.
# RESEND_API_KEY=re_your-resend-api-key
# RESEND_FROM_EMAIL=Smart Stock Alerts <alerts@your-verified-domain.com>

# Optional fallback recipient if the Supabase recipient table is unavailable.
ADMIN_EMAIL=admin@example.com
